{
  "name": "phosphene",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c yellow,cyan \"python3 studio/dev.py\" \"vite studio/web\"",
    "web": "vite studio/web",
    "api": "python3 studio/dev.py",
    "build": "vite build studio/web",
    "log": "python3 studio/gen_log.py",
    "test": "node --test studio/tests/js/ui.test.cjs",
    "test:e2e": "node --test studio/tests/e2e/*.e2e.test.cjs"
  },
  "devDependencies": {
    "concurrently": "^9.0.0",
    "playwright-core": "^1.64.1",
    "vite": "^7.0.0"
  }
}

{
  "name": "phosphene",
  "private": true,
  "type": "module",
  "scripts": {
    "setup": "bash scripts/setup.sh",
    "dev": "concurrently -k -n api,web -c yellow,cyan \"python3 studio/dev.py\" \"vite studio/web\"",
    "web": "vite studio/web",
    "api": "python3 studio/dev.py",
    "build": "vite build studio/web",
    "log": "python3 studio/gen_log.py",
    "qa:replay": ".venv/bin/python studio/qa_replay.py",
    "test": "node --test studio/tests/js/ui.test.cjs",
    "test:e2e": "node --test studio/tests/e2e/*.e2e.test.cjs",
    "app": "cd app && tauri dev",
    "app:build": ".venv/bin/python app/build.py && cd app && TAURI_SIGNING_PRIVATE_KEY=\"$(cat ~/.tauri/phosphene.key)\" TAURI_SIGNING_PRIVATE_KEY_PASSWORD=\"\" tauri build",
    "release": "bash scripts/release.sh",
    "dev:app": "PHOSPHENE_HOME=\"$HOME/Documents/Phosphene\" PHOSPHENE_SUPPORT=\"$HOME/Library/Application Support/Phosphene\" npm run dev",
    "app:live": "concurrently -k -n data,window -c yellow,magenta \"npm run dev:app\" \"npm run app\""
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.4",
    "concurrently": "^9.0.0",
    "playwright-core": "^1.64.1",
    "vite": "^7.0.0"
  },
  "version": "0.1.6"
}

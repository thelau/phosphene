{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "The page (served by the app's own server on this computer) may check for updates, restart the app and open links in the browser.",
  "windows": [
    "main"
  ],
  "remote": {
    "urls": [
      "http://localhost:*",
      "http://127.0.0.1:*"
    ]
  },
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "updater:default",
    "process:allow-restart",
    "opener:allow-open-url"
  ]
}

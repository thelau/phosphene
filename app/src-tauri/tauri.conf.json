{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Phosphene",
  "version": "0.1.0",
  "identifier": "app.phosphene.studio",
  "build": {
    "frontendDist": "../splash",
    "devUrl": "http://localhost:5173"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "category": "public.app-category.graphics-design",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.png"
    ],
    "resources": {
      "../build/resources/server/": "server/",
      "../build/resources/web/": "web/",
      "../build/resources/bin/": "bin/"
    },
    "macOS": {
      "minimumSystemVersion": "13.0"
    },
    "createUpdaterArtifacts": true,
    "fileAssociations": [
      {
        "ext": [
          "phos",
          "phosphene"
        ],
        "name": "Phosphene Project",
        "description": "A Phosphene project: its mark, settings, images, groups and snapshots",
        "role": "Editor",
        "mimeType": "application/x-phosphene"
      }
    ]
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/thelau/phosphene-releases/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDg5RjA1ODJDNTdFODEwOTYKUldTV0VPaFhMRmp3aVFOUWxuRUF1VmE5SURUTXNnRjl3SWRnTVRNa2JtdXlPSm9VT21iYVVCRXgK"
    }
  }
}
